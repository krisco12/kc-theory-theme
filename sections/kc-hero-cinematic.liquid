{% comment %}
  ============================================================
  KC THEORY — Cinematic Hero Section
  Version: 2.0 (2026 Redesign)
  Description: Full-viewport cinematic hero with parallax depth,
               god-ray overlay, bold typography, and dual CTAs.
               Designed for the "Lone Adventurer" brand narrative.
  ============================================================
{% endcomment %}

{{ 'kc-brand.css' | asset_url | stylesheet_tag }}

<section
  class="kc-hero-cinematic"
  id="kc-hero-cinematic"
  data-parallax="true"
  aria-label="Hero section"
>
  {%- comment -%} Background image layer {%- endcomment -%}
  <div class="kc-hero-cinematic__bg" aria-hidden="true">
    {%- if section.settings.hero_image != blank -%}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.hero_image | image_url: width: 800 }} 800w,
          {{ section.settings.hero_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.hero_image | image_url: width: 1800 }} 1800w,
          {{ section.settings.hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.hero_image.alt | escape }}"
        class="kc-hero-cinematic__bg-img"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="kc-hero-cinematic__bg-placeholder" aria-hidden="true"></div>
    {%- endif -%}

    {%- comment -%} Cinematic overlay layers {%- endcomment -%}
    <div class="kc-hero-cinematic__overlay kc-hero-cinematic__overlay--gradient" aria-hidden="true"></div>
    <div class="kc-hero-cinematic__overlay kc-hero-cinematic__overlay--vignette" aria-hidden="true"></div>
    <div class="kc-hero-cinematic__overlay kc-hero-cinematic__overlay--god-rays" aria-hidden="true"></div>
  </div>

  {%- comment -%} Content layer {%- endcomment -%}
  <div class="kc-hero-cinematic__content kc-container">
    <div class="kc-hero-cinematic__inner">

      {%- comment -%} Eyebrow label {%- endcomment -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="kc-eyebrow kc-hero-cinematic__eyebrow kc-animate-fade-up">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- comment -%} Main headline {%- endcomment -%}
      <h1 class="kc-hero-cinematic__headline kc-animate-fade-up kc-animate-fade-up--delay-1">
        {{ section.settings.headline | default: "Clarity.<br>Control.<br>Confidence." }}
      </h1>

      {%- comment -%} Subheadline {%- endcomment -%}
      {%- if section.settings.subheadline != blank -%}
        <p class="kc-hero-cinematic__subheadline kc-body-lg kc-animate-fade-up kc-animate-fade-up--delay-2">
          {{ section.settings.subheadline }}
        </p>
      {%- endif -%}

      {%- comment -%} CTA Buttons {%- endcomment -%}
      <div class="kc-hero-cinematic__ctas kc-animate-fade-up kc-animate-fade-up--delay-3">
        {%- if section.settings.primary_cta_text != blank -%}
          <a
            href="{{ section.settings.primary_cta_url | default: '/pages/quiz' }}"
            class="kc-btn kc-btn--primary kc-glow-pulse"
            aria-label="{{ section.settings.primary_cta_text }}"
          >
            {{ section.settings.primary_cta_text }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_cta_text != blank -%}
          <a
            href="{{ section.settings.secondary_cta_url | default: '/collections/all' }}"
            class="kc-btn kc-btn--secondary"
            aria-label="{{ section.settings.secondary_cta_text }}"
          >
            {{ section.settings.secondary_cta_text }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Trust bar {%- endcomment -%}
      {%- if section.settings.show_trust_bar -%}
        <div class="kc-hero-cinematic__trust kc-animate-fade-up kc-animate-fade-up--delay-3">
          <span class="kc-hero-cinematic__trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Lived experience. Not clinical jargon.
          </span>
          <span class="kc-hero-cinematic__trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Built for men who think differently.
          </span>
          <span class="kc-hero-cinematic__trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Australian owned & operated.
          </span>
        </div>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  {%- if section.settings.show_scroll_indicator -%}
    <div class="kc-hero-cinematic__scroll" aria-hidden="true">
      <span class="kc-hero-cinematic__scroll-line"></span>
    </div>
  {%- endif -%}

</section>

<style>
  /* ---- Hero Cinematic Section Styles ---- */
  .kc-hero-cinematic {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--kc-navy-deep);
  }

  /* Background */
  .kc-hero-cinematic__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .kc-hero-cinematic__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.05);
    transition: transform 0.1s linear;
    will-change: transform;
  }

  .kc-hero-cinematic__bg-placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 60% 40%, #003060 0%, #001020 70%);
  }

  /* Overlay layers */
  .kc-hero-cinematic__overlay {
    position: absolute;
    inset: 0;
  }

  .kc-hero-cinematic__overlay--gradient {
    background: linear-gradient(
      105deg,
      rgba(0, 10, 20, 0.88) 0%,
      rgba(0, 20, 40, 0.70) 40%,
      rgba(0, 30, 60, 0.30) 100%
    );
    z-index: 1;
  }

  .kc-hero-cinematic__overlay--vignette {
    background: radial-gradient(
      ellipse at center,
      transparent 40%,
      rgba(0, 5, 15, 0.7) 100%
    );
    z-index: 2;
  }

  .kc-hero-cinematic__overlay--god-rays {
    background: radial-gradient(
      ellipse 60% 80% at 65% 20%,
      rgba(192, 160, 96, 0.08) 0%,
      transparent 70%
    );
    z-index: 3;
    pointer-events: none;
  }

  /* Content */
  .kc-hero-cinematic__content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-top: clamp(5rem, 12vh, 9rem);
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }

  .kc-hero-cinematic__inner {
    max-width: 720px;
  }

  /* Eyebrow */
  .kc-hero-cinematic__eyebrow {
    margin-bottom: 1.25rem;
  }

  /* Headline */
  .kc-hero-cinematic__headline {
    font-family: var(--kc-font-heading);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--kc-white);
    margin: 0 0 1.5rem;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.6);
  }

  /* Subheadline */
  .kc-hero-cinematic__subheadline {
    max-width: 560px;
    margin-bottom: 2.5rem;
    color: var(--kc-mist);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  /* CTAs */
  .kc-hero-cinematic__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .kc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9em 2.25em;
    border-radius: var(--kc-radius);
    font-family: var(--kc-font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--kc-transition);
    cursor: pointer;
    border: 2px solid transparent;
    white-space: nowrap;
  }

  .kc-btn--primary {
    background: linear-gradient(135deg, var(--kc-gold), var(--kc-gold-bright));
    color: var(--kc-navy-deep);
    border-color: transparent;
  }

  .kc-btn--primary:hover {
    background: linear-gradient(135deg, var(--kc-gold-bright), var(--kc-gold));
    color: var(--kc-navy-deep);
    transform: translateY(-2px);
    box-shadow: var(--kc-glow-gold);
  }

  .kc-btn--secondary {
    background: transparent;
    color: var(--kc-white);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .kc-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--kc-gold);
    color: var(--kc-gold);
    transform: translateY(-2px);
  }

  /* Trust bar */
  .kc-hero-cinematic__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
  }

  .kc-hero-cinematic__trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--kc-mist);
    opacity: 0.8;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .kc-hero-cinematic__trust-item svg {
    color: var(--kc-gold);
    flex-shrink: 0;
  }

  /* Scroll indicator */
  .kc-hero-cinematic__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kc-hero-cinematic__scroll-line {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--kc-gold), transparent);
    animation: kc-scroll-line 2s ease-in-out infinite;
  }

  @keyframes kc-scroll-line {
    0%, 100% { opacity: 0.3; transform: scaleY(0.7); }
    50%       { opacity: 1;   transform: scaleY(1); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .kc-hero-cinematic__headline {
      font-size: clamp(3rem, 14vw, 5rem);
    }
    .kc-hero-cinematic__trust {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>

<script>
  /* Parallax scroll effect for hero background */
  (function() {
    var hero = document.getElementById('kc-hero-cinematic');
    if (!hero || !hero.dataset.parallax) return;
    var bg = hero.querySelector('.kc-hero-cinematic__bg-img');
    if (!bg) return;

    var ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(function() {
          var scrollY = window.scrollY;
          var heroH = hero.offsetHeight;
          if (scrollY < heroH) {
            var offset = scrollY * 0.35;
            bg.style.transform = 'scale(1.05) translateY(' + offset + 'px)';
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "KC Cinematic Hero",
  "tag": "section",
  "class": "kc-section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image",
      "info": "Recommended: 2400×1600px or wider. Use the KC Theory 'Lone Adventurer' mountain image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "The KC Theory"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Main Headline",
      "default": "<p>Clarity.<br>Control.<br>Confidence.</p>"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Built for men who think differently. Practical tools, lived-experience coaching, and a system that actually works for the ADHD brain."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Start Your Focus Assessment"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Explore the Tools"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show Trust Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "KC Cinematic Hero",
      "settings": {
        "eyebrow": "The KC Theory",
        "subheadline": "Built for men who think differently. Practical tools, lived-experience coaching, and a system that actually works for the ADHD brain.",
        "primary_cta_text": "Start Your Focus Assessment",
        "secondary_cta_text": "Explore the Tools",
        "show_trust_bar": true,
        "show_scroll_indicator": true
      }
    }
  ]
}
{% endschema %}
