{% comment %}
  ============================================================
  KC Theory — Hero Section (Cinematic)
  ============================================================
  File        : sections/kc-hero-cinematic.liquid
  Description : Full-screen cinematic hero with parallax
                background, volumetric god-rays overlay,
                stagger reveal animations, and dual CTAs.
  Assets      : kc_hero_theory_final.png (upload to theme assets)
  ============================================================
{% endcomment %}

<section
  id="hero"
  class="kc-hero"
  style="
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #001020;
  "
>

  {%- comment -%} ── Parallax Background ── {%- endcomment -%}
  <div
    class="kc-hero__parallax-bg"
    style="
      position: absolute;
      inset: -20%;
      background-image: url('{{ section.settings.hero_image | default: 'kc_hero_theory_final.png' | asset_url }}');
      background-size: cover;
      background-position: center 30%;
      background-repeat: no-repeat;
      will-change: transform;
    "
  ></div>

  {%- comment -%} ── Dark Gradient Overlay ── {%- endcomment -%}
  <div style="
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,10,20,0.3)  0%,
      rgba(0,10,20,0.55) 40%,
      rgba(0,10,20,0.85) 80%,
      rgba(0,10,20,1)    100%
    );
  "></div>

  {%- comment -%} ── Volumetric God-Rays ── {%- endcomment -%}
  <div style="
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 25%, rgba(212,168,83,0.08) 0%, transparent 65%);
    pointer-events: none;
  "></div>

  {%- comment -%} ── Content ── {%- endcomment -%}
  <div class="kc-container" style="
    position: relative;
    z-index: 10;
    text-align: center;
    padding-top: 8rem;
    padding-bottom: 6rem;
  ">

    {%- comment -%} Pre-headline {%- endcomment -%}
    <span
      class="kc-eyebrow kc-reveal"
      style="margin-bottom: 1.5rem;"
    >
      {{ section.settings.eyebrow | default: "The 3 C's: Commitment · Consistency · Compassion" }}
    </span>

    {%- comment -%} Main Headline Line 1 {%- endcomment -%}
    <h1
      class="kc-reveal kc-reveal--delay-1"
      style="
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(3rem, 9vw, 7.5rem);
        letter-spacing: -0.03em;
        line-height: 1.0;
        color: #ffffff;
        margin: 0 0 0.2em;
        text-shadow: 0 4px 40px rgba(0,0,0,0.8);
      "
    >
      {{ section.settings.headline_line1 | default: "Stop Surviving." }}
    </h1>

    {%- comment -%} Main Headline Line 2 (gold gradient) {%- endcomment -%}
    <h1
      class="kc-reveal kc-reveal--delay-2"
      style="
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(3rem, 9vw, 7.5rem);
        letter-spacing: -0.03em;
        line-height: 1.0;
        background: linear-gradient(135deg, #C0A060, #E8C46A, #D4A853);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0 0 1.5rem;
        filter: drop-shadow(0 0 20px rgba(212,168,83,0.3));
      "
    >
      {{ section.settings.headline_line2 | default: "Start Climbing." }}
    </h1>

    {%- comment -%} Gold divider {%- endcomment -%}
    <div
      class="kc-reveal kc-reveal--delay-3"
      style="margin-bottom: 2rem;"
    >
      <div class="kc-divider" style="width: 80px; margin: 0 auto;"></div>
    </div>

    {%- comment -%} Subheadline {%- endcomment -%}
    <p
      class="kc-reveal kc-reveal--delay-4"
      style="
        font-family: 'Open Sans', sans-serif;
        font-weight: 400;
        font-size: clamp(1rem, 2.2vw, 1.2rem);
        line-height: 1.8;
        color: rgba(255,255,255,0.75);
        max-width: 640px;
        margin: 0 auto 2.5rem;
      "
    >
      {{ section.settings.subheadline | default: "Practical, no-bullshit strategies for navigating ADHD, trauma, and the chaos of your own mind. Built on lived experience, grounded in the 3 C's: Commitment, Consistency, and Compassion." }}
    </p>

    {%- comment -%} CTA Buttons {%- endcomment -%}
    <div
      class="kc-reveal kc-reveal--delay-5"
      style="
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      "
    >
      <a
        href="{{ section.settings.cta_primary_url | default: '#contact' }}"
        class="kc-btn-gold"
      >
        <span>{{ section.settings.cta_primary_label | default: "Get the Free Guide" }}</span>
      </a>
      <a
        href="{{ section.settings.cta_secondary_url | default: '#offerings' }}"
        class="kc-btn-outline"
      >
        {{ section.settings.cta_secondary_label | default: "Explore the 10 Core Areas" }}
      </a>
    </div>

  </div>

  {%- comment -%} ── Scroll Indicator ── {%- endcomment -%}
  <div
    class="kc-hero__scroll-indicator kc-reveal kc-reveal--delay-6"
    style="
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    "
  >
    <span style="
      font-family: 'Montserrat', sans-serif;
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
    ">Scroll</span>
    <svg
      width="20" height="20" viewBox="0 0 24 24" fill="none"
      stroke="rgba(212,168,83,0.6)" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round"
      style="animation: bounceY 1.5s ease-in-out infinite;"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>

</section>

{% schema %}
{
  "name": "KC Hero — Cinematic",
  "tag": "section",
  "class": "kc-section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image",
      "info": "Recommended: kc_hero_theory_final.png — 1920×1080px minimum"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The 3 C's: Commitment · Consistency · Compassion"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline — Line 1 (white)",
      "default": "Stop Surviving."
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline — Line 2 (gold gradient)",
      "default": "Start Climbing."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Practical, no-bullshit strategies for navigating ADHD, trauma, and the chaos of your own mind. Built on lived experience, grounded in the 3 C's: Commitment, Consistency, and Compassion."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA Label",
      "default": "Get the Free Guide"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA Label",
      "default": "Explore the 10 Core Areas"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    }
  ],
  "presets": [
    {
      "name": "KC Hero — Cinematic"
    }
  ]
}
{% endschema %}
