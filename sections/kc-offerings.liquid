{% comment %}
  KC Theory — The Toolkit / 10 Core Areas Section
  Design: Dark background with offerings background image, 10 pillar cards in a responsive grid
  Each card: numbered, icon, title, description
  Brand: Deep Navy + Radiant Gold | Montserrat headings | Open Sans body
{% endcomment %}

{{ 'kc-brand.css' | asset_url | stylesheet_tag }}

<section class="kc-offerings" id="kc-offerings" data-section-id="{{ section.id }}">

  <div class="kc-offerings__bg" style="background-image: url('{{ 'kc-offerings-bg.jpg' | asset_url }}');"></div>
  <div class="kc-offerings__overlay"></div>

  <div class="kc-offerings__container kc-container">

    <div class="kc-offerings__header">
      <span class="kc-eyebrow kc-animate-fade-up">{{ section.settings.eyebrow | default: 'The Toolkit' }}</span>
      <h2 class="kc-offerings__headline kc-animate-fade-up kc-animate-fade-up--delay-1">
        {{ section.settings.headline | default: 'The 10 Core Areas' }}
      </h2>
      <div class="kc-offerings__divider kc-animate-fade-up kc-animate-fade-up--delay-1"></div>
      <p class="kc-offerings__intro kc-animate-fade-up kc-animate-fade-up--delay-2">
        {{ section.settings.intro | default: "These aren't just topics. They're the pillars I've personally had to rebuild. Each one is a core area where ADHD, trauma, and mental health intersect with daily life — and where real, practical change is possible." }}
      </p>
    </div>

    <div class="kc-offerings__grid">
      {%- for block in section.blocks -%}
        <div class="kc-offerings__card kc-animate-fade-up" {{ block.shopify_attributes }}>
          <div class="kc-offerings__card-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <div class="kc-offerings__card-icon" aria-hidden="true">{{ block.settings.icon_svg }}</div>
          <h3 class="kc-offerings__card-title">{{ block.settings.title }}</h3>
          <p class="kc-offerings__card-desc">{{ block.settings.description }}</p>
          {%- if block.settings.cta_label != blank -%}
            <a href="{{ block.settings.cta_link | default: '#' }}" class="kc-offerings__card-link">
              {{ block.settings.cta_label }} &rarr;
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>

</section>

<style>
.kc-offerings {
  position: relative;
  background: #000a18;
  overflow: hidden;
}

.kc-offerings__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.18;
}

@media (max-width: 768px) {
  .kc-offerings__bg { background-attachment: scroll; }
}

.kc-offerings__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,10,24,0.92) 0%, rgba(0,10,24,0.75) 40%, rgba(0,10,24,0.92) 100%);
}

.kc-offerings__container {
  position: relative;
  z-index: 10;
  padding-top: clamp(4rem, 8vw, 7rem);
  padding-bottom: clamp(4rem, 8vw, 7rem);
}

.kc-offerings__header {
  text-align: center;
  margin-bottom: 3.5rem;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

.kc-offerings__headline {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 900 !important;
  font-size: clamp(1.8rem, 4vw, 3rem) !important;
  letter-spacing: -0.02em !important;
  color: #ffffff !important;
  margin: 0.75rem 0 0 !important;
  line-height: 1.1 !important;
}

.kc-offerings__divider {
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,168,83,0.6), transparent);
  margin: 1.25rem auto;
}

.kc-offerings__intro {
  font-family: 'Open Sans', sans-serif;
  font-size: clamp(0.9rem, 1.6vw, 1rem);
  line-height: 1.8;
  color: rgba(255,255,255,0.60);
  margin: 0;
}

.kc-offerings__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

@media (min-width: 1024px) {
  .kc-offerings__grid {
    grid-template-columns: repeat(5, 1fr);
  }
}

@media (min-width: 640px) and (max-width: 1023px) {
  .kc-offerings__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.kc-offerings__card {
  background: rgba(0,20,40,0.55);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 6px;
  padding: 1.75rem 1.5rem;
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.kc-offerings__card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(212,168,83,0), transparent);
  transition: all 0.4s ease;
}

.kc-offerings__card:hover {
  background: rgba(0,30,60,0.75);
  border-color: rgba(212,168,83,0.2);
  transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.5);
}

.kc-offerings__card:hover::before {
  background: linear-gradient(90deg, transparent, rgba(212,168,83,0.6), transparent);
}

.kc-offerings__card-num {
  font-family: 'Montserrat', sans-serif;
  font-weight: 900;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: rgba(212,168,83,0.45);
  position: absolute;
  top: 1rem;
  right: 1rem;
}

.kc-offerings__card-icon {
  width: 36px;
  height: 36px;
  color: rgba(212,168,83,0.75);
  flex-shrink: 0;
}

.kc-offerings__card-icon svg {
  width: 100%;
  height: 100%;
}

.kc-offerings__card-title {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 700 !important;
  font-size: 1rem !important;
  color: #ffffff !important;
  line-height: 1.3 !important;
  margin: 0 !important;
}

.kc-offerings__card-desc {
  font-family: 'Open Sans', sans-serif;
  font-size: 0.82rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.55);
  margin: 0;
  flex: 1;
}

.kc-offerings__card-link {
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(212,168,83,0.7) !important;
  text-decoration: none;
  transition: color 0.3s ease;
  margin-top: auto;
}

.kc-offerings__card-link:hover {
  color: #E8C46A !important;
  text-decoration: none;
}
</style>

{% schema %}
