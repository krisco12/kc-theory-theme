        { "type": "pillar", "settings": { "number": "04", "title": "Listening to Your Body",                 "description": "Understand the physical signals your brain is ignoring." } },
        { "type": "pillar", "settings": { "number": "05", "title": "Working With ADHD",                      "description": "Strategies for focus, executive function, and emotional regulation." } },
        { "type": "pillar", "settings": { "number": "06", "title": "Building on Your Strengths",             "description": "Stop focusing only on what's broken and leverage what works." } },
        { "type": "pillar", "settings": { "number": "07", "title": "Getting Your Internal Voices Sorted",    "description": "Tame the inner critic that tells you you're weak or broken." } },
        { "type": "pillar", "settings": { "number": "08", "title": "Training Your Brain",                    "description": "Practical exercises to build resilience and mental flexibility." } },
        { "type": "pillar", "settings": { "number": "09", "title": "Fixing Your Relationships",              "description": "Rebuild trust, connection, and healthy boundaries." } },
        { "type": "pillar", "settings": { "number": "10", "title": "Putting It All Together",                "description": "Integrate the strategies into a life that actually works for you." } }
      ]
    }
  ]
}
{% endschema %}
