        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description",
          "default": "Calm the fight-or-flight response that never quite switches off."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KC Offerings",
      "blocks": [
        { "type": "pillar", "settings": { "number": "01", "title": "Getting Your Nervous System Right",       "description": "Calm the fight-or-flight response that never quite switches off." } },
        { "type": "pillar", "settings": { "number": "02", "title": "Fixing Your Thinking",                   "description": "Break out of negative thought loops and cognitive distortions." } },
