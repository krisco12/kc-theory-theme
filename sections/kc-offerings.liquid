{% comment %}
  ============================================================
  KC Theory — Offerings / 10 Core Areas Section
  ============================================================
  File        : sections/kc-offerings.liquid
  Description : Dark monolithic grid of 10 pillar cards with
                gold top-border glow on hover, cinematic
                background, and scroll-reveal animations.
  Assets      : kc-offerings-bg.jpg (upload to theme assets)
  ============================================================
{% endcomment %}

<section
  id="offerings"
  style="
    position: relative;
    overflow: hidden;
    background: #000a18;
  "
>

  {%- comment -%} ── Background ── {%- endcomment -%}
  <div
    class="kc-parallax-bg"
    style="
      position: absolute;
      inset: 0;
      background-image: url('{{ section.settings.bg_image | default: 'kc-offerings-bg.jpg' | asset_url }}');
      background-size: cover;
      background-position: center top;
      opacity: 0.45;
    "
  ></div>

  {%- comment -%} ── Overlay ── {%- endcomment -%}
  <div style="
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,10,24,0.85) 0%,
      rgba(0,10,24,0.7)  30%,
      rgba(0,10,24,0.85) 100%
    );
  "></div>

  {%- comment -%} ── Section Number Watermark ── {%- endcomment -%}
  <div class="kc-section-num" style="top: -2rem; right: -1rem; left: auto;">02</div>

  {%- comment -%} ── Content ── {%- endcomment -%}
  <div class="kc-container" style="
    position: relative;
    z-index: 10;
    padding-top: 7rem;
    padding-bottom: 7rem;
  ">

    {%- comment -%} Section Header {%- endcomment -%}
    <div style="text-align: center; margin-bottom: 4rem;">
      <span class="kc-eyebrow kc-reveal" style="margin-bottom: 1rem;">
        {{ section.settings.eyebrow | default: "The Framework" }}
      </span>

      <h2
        class="kc-reveal kc-reveal--delay-1"
        style="
          font-family: 'Montserrat', sans-serif;
          font-weight: 900;
          font-size: clamp(1.8rem, 4.5vw, 3.5rem);
          letter-spacing: -0.02em;
          line-height: 1.1;
          color: #ffffff;
          margin-bottom: 1.5rem;
        "
      >
        {{ section.settings.headline | default: "The Toolkit:" }}
        <span class="kc-gold-text">
          {{ section.settings.headline_gold | default: "10 Core Areas" }}
        </span>
        {{ section.settings.headline_suffix | default: "to Get Your Head Right" }}
      </h2>

      <div class="kc-reveal kc-reveal--delay-2">
        <div class="kc-divider" style="width: 80px; margin: 0 auto 1.5rem;"></div>
      </div>

      <p
        class="kc-reveal kc-reveal--delay-3"
        style="
          font-family: 'Open Sans', sans-serif;
          font-size: clamp(0.95rem, 1.8vw, 1.05rem);
          line-height: 1.8;
          color: rgba(255,255,255,0.65);
          max-width: 640px;
          margin: 0 auto;
        "
      >
        {{ section.settings.intro | default: "Mental health isn't simple, but it doesn't have to be complicated. Pick the one that feels most urgent, give it a proper go, and build from there." }}
      </p>
    </div>

    {%- comment -%} ── Pillar Cards Grid ── {%- endcomment -%}
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
      margin-bottom: 3.5rem;
    ">

      {%- assign card_delay = 1 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <div
            class="kc-pillar-card kc-reveal kc-reveal--delay-{{ card_delay }}"
            {{ block.shopify_attributes }}
            style="padding: 1.75rem;"
          >
            <div
              class="kc-gold-text"
              style="
                font-family: 'Montserrat', sans-serif;
                font-weight: 900;
                font-size: 2.5rem;
                line-height: 1;
                margin-bottom: 0.75rem;
                opacity: 0.7;
              "
            >
              {{ block.settings.number | default: "01" }}
            </div>

            <h3 style="
              font-family: 'Montserrat', sans-serif;
              font-weight: 800;
              font-size: 1rem;
              letter-spacing: -0.01em;
              color: rgba(255,255,255,0.92);
              margin-bottom: 0.6rem;
              line-height: 1.3;
            ">
              {{ block.settings.title | default: "Getting Your Nervous System Right" }}
            </h3>

            <p style="
              font-family: 'Open Sans', sans-serif;
              font-size: 0.875rem;
              line-height: 1.7;
              color: rgba(255,255,255,0.55);
              margin: 0;
            ">
              {{ block.settings.description | default: "Calm the fight-or-flight response that never quite switches off." }}
            </p>
          </div>
          {%- assign card_delay = card_delay | plus: 1 -%}
          {%- if card_delay > 10 -%}{%- assign card_delay = 10 -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} ── CTA Button ── {%- endcomment -%}
    <div class="kc-reveal" style="text-align: center;">
      <a
        href="{{ section.settings.cta_url | default: '#contact' }}"
        class="kc-btn-gold"
      >
        <span>{{ section.settings.cta_label | default: "Dive Into the E-Books" }}</span>
      </a>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "KC Offerings",
  "tag": "section",
  "class": "kc-section-offerings",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Recommended: kc-offerings-bg.jpg — dark god-rays sky"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "The Framework"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (white portion)",
      "default": "The Toolkit:"
    },
    {
      "type": "text",
      "id": "headline_gold",
      "label": "Headline (gold portion)",
      "default": "10 Core Areas"
    },
    {
      "type": "text",
      "id": "headline_suffix",
      "label": "Headline (white suffix)",
      "default": "to Get Your Head Right"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Paragraph",
      "default": "Mental health isn't simple, but it doesn't have to be complicated. Pick the one that feels most urgent, give it a proper go, and build from there."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Dive Into the E-Books"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number (e.g. 01)",
