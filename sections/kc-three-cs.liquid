{% comment %}
  KC Theory — The 3 C's Section
  Design: Dark navy background with radial glow, three card columns
  Each card: large letter watermark, gold word, body description
  Brand: Deep Navy + Radiant Gold | Montserrat headings | Open Sans body
{% endcomment %}

{{ 'kc-brand.css' | asset_url | stylesheet_tag }}

<section class="kc-three-cs" id="kc-three-cs" data-section-id="{{ section.id }}">

  <div class="kc-three-cs__glow" aria-hidden="true"></div>

  <div class="kc-three-cs__container kc-container">

    <div class="kc-three-cs__header">
      <span class="kc-eyebrow kc-animate-fade-up">{{ section.settings.eyebrow | default: 'The Foundation' }}</span>
      <h2 class="kc-three-cs__headline kc-animate-fade-up kc-animate-fade-up--delay-1">
        {{ section.settings.headline | default: 'Everything Is Built on Three Things.' }}
      </h2>
      <div class="kc-three-cs__divider kc-animate-fade-up kc-animate-fade-up--delay-1"></div>
    </div>

    <div class="kc-three-cs__grid">

      {%- for block in section.blocks -%}
        <div class="kc-three-cs__card kc-animate-fade-up" {{ block.shopify_attributes }}>
          <div class="kc-three-cs__card-watermark" aria-hidden="true">{{ block.settings.letter }}</div>
          <div class="kc-three-cs__card-word">{{ block.settings.word }}</div>
          <p class="kc-three-cs__card-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}

    </div>

  </div>

</section>

<style>
.kc-three-cs {
  position: relative;
  background: linear-gradient(180deg, #000e1c 0%, #001428 50%, #000e1c 100%);
  overflow: hidden;
}

.kc-three-cs__glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(212,168,83,0.04) 0%, transparent 70%);
  pointer-events: none;
}

.kc-three-cs__container {
  position: relative;
  z-index: 10;
  padding-top: clamp(4rem, 8vw, 6rem);
  padding-bottom: clamp(4rem, 8vw, 6rem);
}

.kc-three-cs__header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.kc-three-cs__headline {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 900 !important;
  font-size: clamp(1.6rem, 4vw, 3rem) !important;
  letter-spacing: -0.02em !important;
  color: #ffffff !important;
  margin: 0.75rem 0 0 !important;
  line-height: 1.1 !important;
}

.kc-three-cs__divider {
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,168,83,0.6), transparent);
  margin: 1.25rem auto 0;
}

.kc-three-cs__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 2rem;
  max-width: 900px;
  margin: 0 auto;
}

.kc-three-cs__card {
  text-align: center;
  padding: 2rem 1.5rem;
  background: rgba(0,20,40,0.5);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 6px;
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
}

.kc-three-cs__card:hover {
  background: rgba(0,30,60,0.7);
  border-color: rgba(212,168,83,0.2);
  transform: translateY(-3px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.4);
}

.kc-three-cs__card-watermark {
  position: absolute;
  top: -0.5rem;
  left: 50%;
  transform: translateX(-50%);
  font-family: 'Montserrat', sans-serif;
  font-weight: 900;
  font-size: 8rem;
  color: rgba(212,168,83,0.035);
  line-height: 1;
  pointer-events: none;
  user-select: none;
}

.kc-three-cs__card-word {
  font-family: 'Montserrat', sans-serif;
  font-weight: 900;
  font-size: 2rem;
  background: linear-gradient(135deg, #C0A060, #E8C46A);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.6rem;
  position: relative;
}

.kc-three-cs__card-desc {
  font-family: 'Open Sans', sans-serif;
  font-size: 0.9rem;
  line-height: 1.75;
  color: rgba(255,255,255,0.58);
  position: relative;
  margin: 0;
}
</style>

{% schema %}
{
  "name": "KC Three C's",
  "tag": "section",
  "class": "kc-section-three-cs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "The Foundation"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Everything Is Built on Three Things."
    }
  ],
  "blocks": [
    {
      "type": "c_item",
      "name": "C Item",
      "settings": [
        {
          "type": "text",
          "id": "letter",
          "label": "Letter",
          "default": "C"
        },
        {
          "type": "text",
          "id": "word",
          "label": "Word",
          "default": "Commitment"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Doing the work, even when you don't feel like it. Especially then."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KC Three C's",
      "blocks": [
        {
          "type": "c_item",
          "settings": {
            "letter": "C",
            "word": "Commitment",
            "description": "Doing the work, even when you don't feel like it. Especially then."
          }
        },
        {
          "type": "c_item",
          "settings": {
            "letter": "C",
            "word": "Consistency",
            "description": "Small actions, repeated daily. That's where the real change lives."
          }
        },
        {
          "type": "c_item",
          "settings": {
            "letter": "C",
            "word": "Compassion",
            "description": "For yourself, when you inevitably stuff up. Because you will. We all do."
          }
        }
      ]
    }
  ]
}
{% endschema %}
