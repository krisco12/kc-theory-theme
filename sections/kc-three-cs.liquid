{% comment %}
  ============================================================
  KC Theory — The 3 C's Section
  ============================================================
  File        : sections/kc-three-cs.liquid
  Description : Bold statement section presenting the three
                foundational pillars: Commitment, Consistency,
                Compassion. Dark navy with gold accents.
  ============================================================
{% endcomment %}

<section
  style="
    position: relative;
    background: linear-gradient(180deg, #000e1c 0%, #001428 50%, #000e1c 100%);
    overflow: hidden;
  "
>

  {%- comment -%} ── Subtle Centre Glow ── {%- endcomment -%}
  <div style="
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(212,168,83,0.05) 0%, transparent 70%);
    pointer-events: none;
  "></div>

  {%- comment -%} ── Content ── {%- endcomment -%}
  <div class="kc-container" style="
    position: relative;
    z-index: 10;
    padding-top: 6rem;
    padding-bottom: 6rem;
  ">

    {%- comment -%} Section Header {%- endcomment -%}
    <div style="text-align: center; margin-bottom: 1rem;">
      <span class="kc-eyebrow kc-reveal">
        {{ section.settings.eyebrow | default: "The Foundation" }}
      </span>
    </div>

    <h2
      class="kc-reveal kc-reveal--delay-1"
      style="
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.6rem, 4vw, 3rem);
        letter-spacing: -0.02em;
        color: #ffffff;
        text-align: center;
        margin-bottom: 0.75rem;
        line-height: 1.1;
      "
    >
      {{ section.settings.headline | default: "Everything Is Built on" }}
      <span class="kc-gold-text">
        {{ section.settings.headline_gold | default: "Three Things." }}
      </span>
    </h2>

    <div class="kc-reveal kc-reveal--delay-2" style="text-align: center; margin-bottom: 3.5rem;">
      <div class="kc-divider" style="width: 60px; margin: 1.25rem auto 0;"></div>
    </div>

    {%- comment -%} ── 3 C's Cards Grid ── {%- endcomment -%}
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 2rem;
      max-width: 900px;
      margin: 0 auto;
    ">

      {%- assign card_delay = 3 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar_card' -%}
          <div
            class="kc-reveal kc-reveal--delay-{{ card_delay }}"
            {{ block.shopify_attributes }}
            style="
              text-align: center;
              padding: 2rem 1.5rem;
              background: rgba(0,20,40,0.5);
              border: 1px solid rgba(255,255,255,0.05);
              border-radius: 0.375rem;
              position: relative;
              overflow: hidden;
            "
          >
            {%- comment -%} Big letter watermark {%- endcomment -%}
            <div style="
              position: absolute;
              top: -0.5rem;
              left: 50%;
              transform: translateX(-50%);
              font-family: 'Montserrat', sans-serif;
              font-weight: 900;
              font-size: 8rem;
              color: rgba(212,168,83,0.04);
              line-height: 1;
              pointer-events: none;
              user-select: none;
            ">{{ block.settings.letter | default: "C" }}</div>

            <div
              class="kc-gold-text"
              style="
                font-family: 'Montserrat', sans-serif;
                font-weight: 900;
                font-size: 2rem;
                margin-bottom: 0.5rem;
                position: relative;
              "
            >
              {{ block.settings.word | default: "Commitment" }}
            </div>

            <p style="
              font-family: 'Open Sans', sans-serif;
              font-size: 0.9rem;
              line-height: 1.75;
              color: rgba(255,255,255,0.6);
              position: relative;
              margin: 0;
            ">
              {{ block.settings.description | default: "Doing the work, even when you don't feel like it. Especially then." }}
            </p>
          </div>
          {%- assign card_delay = card_delay | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "KC Three C's",
  "tag": "section",
  "class": "kc-section-three-cs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "The Foundation"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (white portion)",
      "default": "Everything Is Built on"
    },
    {
      "type": "text",
      "id": "headline_gold",
      "label": "Headline (gold portion)",
      "default": "Three Things."
    }
  ],
  "blocks": [
    {
      "type": "pillar_card",
      "name": "C Pillar Card",
      "settings": [
        {
          "type": "text",
          "id": "letter",
          "label": "Watermark Letter",
          "default": "C"
        },
        {
          "type": "text",
          "id": "word",
          "label": "Pillar Word",
          "default": "Commitment"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Doing the work, even when you don't feel like it. Especially then."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KC Three C's",
      "blocks": [
        {
          "type": "pillar_card",
          "settings": {
            "letter": "C",
            "word": "Commitment",
            "description": "Doing the work, even when you don't feel like it. Especially then."
          }
        },
        {
          "type": "pillar_card",
          "settings": {
            "letter": "C",
            "word": "Consistency",
            "description": "Small actions, repeated daily. That's where the real change lives."
          }
        },
        {
          "type": "pillar_card",
          "settings": {
            "letter": "C",
            "word": "Compassion",
            "description": "For yourself, when you inevitably stuff up. Because you will. We all do."
          }
        }
      ]
    }
  ]
}
{% endschema %}
