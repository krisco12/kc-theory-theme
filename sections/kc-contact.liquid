{% comment %}
  ============================================================
  KC Theory — Contact Section
  ============================================================
  File        : sections/kc-contact.liquid
  Description : Dark navy contact form using Shopify's native
                {% form 'contact' %} tag, cinematic night sky
                background, gold focus glow on inputs,
                scroll-reveal animations, and footer bar.
  Assets      : kc-contact-bg.jpg (upload to theme assets)
  Note        : Shopify's contact form sends messages to the
                store email. No third-party service required.
  ============================================================
{% endcomment %}

<section
  id="contact"
  style="
    position: relative;
    overflow: hidden;
    background: #000810;
  "
>

  {%- comment -%} ── Background ── {%- endcomment -%}
  <div
    class="kc-parallax-bg"
    style="
      position: absolute;
      inset: 0;
      background-image: url('{{ section.settings.bg_image | default: 'kc-contact-bg.jpg' | asset_url }}');
      background-size: cover;
      background-position: center bottom;
      opacity: 0.5;
    "
  ></div>

  {%- comment -%} ── Overlay ── {%- endcomment -%}
  <div style="
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,8,16,0.9)  0%,
      rgba(0,8,16,0.7)  40%,
      rgba(0,8,16,0.9)  100%
    );
  "></div>

  {%- comment -%} ── Section Number Watermark ── {%- endcomment -%}
  <div class="kc-section-num" style="top: -2rem; left: -1rem;">03</div>

  {%- comment -%} ── Content ── {%- endcomment -%}
  <div class="kc-container" style="
    position: relative;
    z-index: 10;
    padding-top: 7rem;
    padding-bottom: 5rem;
  ">
    <div style="max-width: 680px; margin: 0 auto;">

      {%- comment -%} Eyebrow {%- endcomment -%}
      <span class="kc-eyebrow kc-reveal" style="margin-bottom: 1rem; text-align: center; display: block;">
        {{ section.settings.eyebrow | default: "Get in Touch" }}
      </span>

      {%- comment -%} Gold Divider {%- endcomment -%}
      <div class="kc-reveal kc-reveal--delay-1" style="text-align: center; margin-bottom: 2rem;">
        <div class="kc-divider" style="width: 60px; margin: 0 auto;"></div>
      </div>

      {%- comment -%} Headline {%- endcomment -%}
      <h2
        class="kc-reveal kc-reveal--delay-2"
        style="
          font-family: 'Montserrat', sans-serif;
          font-weight: 900;
          font-size: clamp(1.8rem, 4.5vw, 3.2rem);
          letter-spacing: -0.02em;
          line-height: 1.1;
          color: #ffffff;
          margin-bottom: 1.25rem;
          text-align: center;
        "
      >
        {{ section.settings.headline | default: "Ready to" }}
        <span class="kc-gold-text">
          {{ section.settings.headline_gold | default: "Do the Work?" }}
        </span>
      </h2>

      {%- comment -%} Intro copy {%- endcomment -%}
      <p
        class="kc-reveal kc-reveal--delay-3"
        style="
          font-family: 'Open Sans', sans-serif;
          font-size: clamp(0.9rem, 1.8vw, 1rem);
          line-height: 1.8;
          color: rgba(255,255,255,0.6);
          margin-bottom: 0.75rem;
          text-align: center;
        "
      >
        {{ section.settings.intro | default: "If you've got questions, need some direction on where to start, or just want to say g'day, drop a line below." }}
      </p>

      <p
        class="kc-reveal kc-reveal--delay-4"
        style="
          font-family: 'Open Sans', sans-serif;
          font-size: 0.85rem;
          line-height: 1.7;
          color: rgba(255,255,255,0.4);
          margin-bottom: 2.5rem;
          text-align: center;
          font-style: italic;
        "
      >
        {{ section.settings.note | default: "Note: I provide online coaching and guidance only. No automated booking systems here — just real conversations to see if we're a good fit." }}
      </p>

      {%- comment -%}
        ── Shopify Native Contact Form ──
        Messages are delivered to the store's contact email.
        Success state is handled by Shopify via page reload with
        ?contact[posted_successfully]=true query parameter.
      {%- endcomment -%}

      {%- if form.posted_successfully? -%}
        {%- comment -%} ── Success State ── {%- endcomment -%}
        <div
          class="kc-reveal"
          style="
            text-align: center;
            padding: 3rem 2rem;
            background: rgba(0,20,40,0.7);
            border: 1px solid rgba(212,168,83,0.3);
            border-radius: 0.375rem;
          "
        >
          <svg
            width="48" height="48" viewBox="0 0 24 24" fill="none"
            stroke="#D4A853" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round"
            style="margin: 0 auto 1rem; display: block;"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <h3 style="
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            font-size: 1.4rem;
            color: #ffffff;
            margin-bottom: 0.75rem;
          ">Message Sent</h3>
          <p style="
            font-family: 'Open Sans', sans-serif;
            color: rgba(255,255,255,0.6);
            line-height: 1.7;
            margin: 0;
          ">
            Thanks for reaching out. I'll get back to you when I can — usually within a day or two.
          </p>
        </div>

      {%- else -%}
        {%- comment -%} ── Contact Form ── {%- endcomment -%}
        {% form 'contact' %}

          {%- if form.errors -%}
            <div style="
              background: rgba(180,40,40,0.2);
              border: 1px solid rgba(200,60,60,0.4);
              border-radius: 0.25rem;
              padding: 1rem 1.25rem;
              margin-bottom: 1.5rem;
              font-family: 'Open Sans', sans-serif;
              font-size: 0.875rem;
              color: rgba(255,180,180,0.9);
            ">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div
            class="kc-reveal kc-reveal--delay-5"
            style="
              display: grid;
              grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
              gap: 1.25rem;
              margin-bottom: 1.25rem;
            "
          >
            {%- comment -%} Name {%- endcomment -%}
            <div>
              <label
                for="ContactFormName"
                style="
                  display: block;
                  font-family: 'Montserrat', sans-serif;
                  font-weight: 600;
                  font-size: 0.72rem;
                  letter-spacing: 0.12em;
                  text-transform: uppercase;
                  color: rgba(255,255,255,0.5);
                  margin-bottom: 0.5rem;
                "
              >Name</label>
              <input
                type="text"
                id="ContactFormName"
                name="contact[name]"
                autocomplete="name"
                placeholder="{{ section.settings.name_placeholder | default: 'Your name' }}"
                value="{{ form.name }}"
                class="kc-input"
              >
            </div>

            {%- comment -%} Email {%- endcomment -%}
            <div>
              <label
                for="ContactFormEmail"
                style="
                  display: block;
                  font-family: 'Montserrat', sans-serif;
                  font-weight: 600;
                  font-size: 0.72rem;
                  letter-spacing: 0.12em;
                  text-transform: uppercase;
                  color: rgba(255,255,255,0.5);
                  margin-bottom: 0.5rem;
                "
              >Email</label>
              <input
                type="email"
                id="ContactFormEmail"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.email_placeholder | default: 'your@email.com' }}"
                value="{{ form.email }}"
                class="kc-input"
                required
              >
            </div>
          </div>

          {%- comment -%} Challenge / Message {%- endcomment -%}
          <div class="kc-reveal kc-reveal--delay-6" style="margin-bottom: 1.25rem;">
            <label
              for="ContactFormMessage"
              style="
                display: block;
                font-family: 'Montserrat', sans-serif;
                font-weight: 600;
                font-size: 0.72rem;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.5);
                margin-bottom: 0.5rem;
              "
            >
              {{ section.settings.message_label | default: "What's the biggest challenge you're facing right now?" }}
            </label>
            <textarea
              id="ContactFormMessage"
              name="contact[body]"
              rows="5"
              placeholder="{{ section.settings.message_placeholder | default: 'Tell me what\'s going on...' }}"
              class="kc-input"
              style="resize: vertical; min-height: 120px;"
            >{{ form.body }}</textarea>
          </div>

          {%- comment -%} Submit {%- endcomment -%}
          <div class="kc-reveal kc-reveal--delay-7">
            <button
              type="submit"
              class="kc-btn-gold"
              style="
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
              "
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span>{{ section.settings.submit_label | default: "Send Message" }}</span>
            </button>
          </div>

        {% endform %}
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} ── Footer Bar ── {%- endcomment -%}
  <div style="
    position: relative;
    z-index: 10;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 2rem 0;
    background: rgba(0,5,12,0.8);
  ">
    <div class="kc-container">
      <div style="
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
        text-align: center;
      ">

        {%- comment -%} Crisis note {%- endcomment -%}
        <p style="
          font-family: 'Open Sans', sans-serif;
          font-size: 0.8rem;
          color: rgba(255,255,255,0.35);
          max-width: 600px;
          line-height: 1.7;
          margin: 0;
        ">
          {{ section.settings.crisis_note | default: "If you're in crisis, please reach out to a professional or call a helpline." }}
          <strong style="color: rgba(255,255,255,0.5);">
            {{ section.settings.crisis_number | default: "Lifeline: 13 11 14" }}
          </strong>
          {{ section.settings.crisis_suffix | default: ". The KC Theory is for building a better life, not for when you're hanging on by a thread." }}
        </p>

        <div class="kc-divider" style="width: 40px;"></div>

        {%- comment -%} Brand wordmark {%- endcomment -%}
        <div style="
          font-family: 'Montserrat', sans-serif;
          font-weight: 900;
          font-size: 0.9rem;
          letter-spacing: 0.1em;
          color: rgba(255,255,255,0.3);
        ">
          THE <span class="kc-gold-text">KC</span> THEORY
        </div>

        {%- comment -%} Copyright {%- endcomment -%}
        <p style="
          font-family: 'Open Sans', sans-serif;
          font-size: 0.75rem;
          color: rgba(255,255,255,0.2);
          margin: 0;
        ">
          &copy; {{ 'now' | date: '%Y' }} The KC Theory. All rights reserved.
        </p>

      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "KC Contact",
  "tag": "section",
  "class": "kc-section-contact",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Recommended: kc-contact-bg.jpg — cinematic starfield night horizon"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (white portion)",
      "default": "Ready to"
    },
    {
      "type": "text",
      "id": "headline_gold",
      "label": "Headline (gold portion)",
      "default": "Do the Work?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Paragraph",
      "default": "If you've got questions, need some direction on where to start, or just want to say g'day, drop a line below."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Italic Note",
      "default": "Note: I provide online coaching and guidance only. No automated booking systems here — just real conversations to see if we're a good fit."
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Field Placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Field Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message Field Label",
      "default": "What's the biggest challenge you're facing right now?"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message Field Placeholder",
      "default": "Tell me what's going on..."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit Button Label",
      "default": "Send Message"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "textarea",
      "id": "crisis_note",
      "label": "Crisis Note (before number)",
      "default": "If you're in crisis, please reach out to a professional or call a helpline."
    },
    {
      "type": "text",
      "id": "crisis_number",
      "label": "Crisis Helpline Number",
      "default": "Lifeline: 13 11 14"
    },
    {
      "type": "textarea",
      "id": "crisis_suffix",
      "label": "Crisis Note (after number)",
      "default": ". The KC Theory is for building a better life, not for when you're hanging on by a thread."
    }
  ],
  "presets": [
    {
      "name": "KC Contact"
    }
  ]
}
{% endschema %}
