{% comment %}
  ============================================================
  KC THEORY — Product Card Snippet
  Usage: {% render 'kc-product-card', product: product %}
  ============================================================
{% endcomment %}

<div class="kc-product-card" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="kc-product-card__link" aria-label="{{ product.title | escape }}">
    <div class="kc-product-card__image-wrap">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="kc-product-card__image"
          loading="lazy"
          width="600"
          height="600"
        >
      {%- else -%}
        <div class="kc-product-card__image-placeholder">
          <span>{{ product.title | truncate: 20 }}</span>
        </div>
      {%- endif -%}

      {%- if product.compare_at_price > product.price -%}
        <span class="kc-product-card__badge">Sale</span>
      {%- elsif product.tags contains 'digital' -%}
        <span class="kc-product-card__badge kc-product-card__badge--digital">Digital</span>
      {%- endif -%}
    </div>

    <div class="kc-product-card__body">
      <h3 class="kc-product-card__title">{{ product.title }}</h3>
      <p class="kc-product-card__excerpt">{{ product.description | strip_html | truncate: 80 }}</p>
      <div class="kc-product-card__footer">
        <span class="kc-product-card__price">
          {{ product.price | money }}
          {%- if product.compare_at_price > product.price -%}
            <s class="kc-product-card__compare">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        </span>
        <span class="kc-product-card__cta">View →</span>
      </div>
    </div>
  </a>
</div>

<style>
  .kc-product-card {
    background: var(--kc-bg-card, #002040);
    border: 1px solid rgba(192,160,96,0.2);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
  }
  .kc-product-card:hover {
    border-color: rgba(192,160,96,0.5);
    box-shadow: 0 0 24px rgba(192,160,96,0.25);
    transform: translateY(-3px);
  }
  .kc-product-card__link { text-decoration: none; display: block; }
  .kc-product-card__image-wrap { position: relative; aspect-ratio: 1/1; overflow: hidden; }
  .kc-product-card__image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .kc-product-card:hover .kc-product-card__image { transform: scale(1.04); }
  .kc-product-card__image-placeholder {
    width: 100%; height: 100%; background: #003060;
    display: flex; align-items: center; justify-content: center;
    color: #C0A060; font-size: 0.9rem; text-align: center; padding: 1rem;
  }
  .kc-product-card__badge {
    position: absolute; top: 12px; left: 12px;
    background: #C0A060; color: #001020;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; padding: 0.3em 0.7em; border-radius: 4px;
  }
  .kc-product-card__badge--digital { background: #003060; color: #C0A060; border: 1px solid #C0A060; }
  .kc-product-card__body { padding: 1.25rem; }
  .kc-product-card__title {
    font-family: 'Montserrat', Arial, sans-serif; font-weight: 700;
    font-size: 1rem; color: #F4F4F0; margin: 0 0 0.4rem; line-height: 1.3;
  }
  .kc-product-card__excerpt { font-size: 0.82rem; color: #D0D0B0; margin: 0 0 1rem; line-height: 1.5; }
  .kc-product-card__footer { display: flex; justify-content: space-between; align-items: center; }
  .kc-product-card__price { font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; color: #C0A060; font-size: 1rem; }
  .kc-product-card__compare { color: #707080; font-weight: 400; font-size: 0.85rem; margin-left: 0.4rem; }
  .kc-product-card__cta { font-size: 0.8rem; font-weight: 700; color: #C0A060; letter-spacing: 0.05em; }
</style>
